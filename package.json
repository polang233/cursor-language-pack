{
  "name": "@polang233/cursor-language-pack",
  "version": "1.1.3",
  "description": "Cursor 简体/繁体中文汉化工具，自动选择系统语言，支持一键安装与恢复。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/polang233/cursor-language-pack.git"
  },
  "homepage": "https://github.com/polang233/cursor-language-pack#readme",
  "bugs": {
    "url": "https://github.com/polang233/cursor-language-pack/issues"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "detect": "node scripts/detect-cursor.mjs",
    "extract": "node scripts/extract.mjs",
    "audit": "node scripts/audit-manifest.mjs",
    "gap": "node scripts/gap.mjs",
    "check-upgrade": "node scripts/check-upgrade.mjs",
    "test": "node scripts/test-extension.mjs && node --test scripts/test-cli.mjs scripts/test-upgrade.mjs scripts/test-commerce.mjs scripts/test-hardcoded.mjs",
    "sync": "node scripts/sync-upstream.mjs",
    "build": "node scripts/build.mjs",
    "coverage": "node scripts/coverage.mjs",
    "validate": "node scripts/validate-dist.mjs",
    "package": "node scripts/package.mjs",
    "translate": "node scripts/translate-install.mjs",
    "publish:ovsx": "node scripts/publish.mjs --registry=ovsx",
    "publish:vsce": "node scripts/publish.mjs --registry=vsce",
    "verify": "node scripts/build.mjs && node scripts/validate-dist.mjs && node scripts/coverage.mjs",
    "clean": "node -e \"for (const d of ['dist','reports']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "prepack": "node scripts/prepare-npm.mjs",
    "package:npm": "node scripts/package-npm.mjs",
    "test:cli": "node --test scripts/test-cli.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:upgrade": "node --test scripts/test-upgrade.mjs",
    "test:commerce": "node --test scripts/test-commerce.mjs",
    "validate:install": "node scripts/validate-install.mjs",
    "test:published": "node scripts/test-package.mjs --published"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.1",
    "opencc-js": "1.4.1",
    "ovsx": "0.10.1"
  },
  "$devDependencies": "opencc-js is only used by scripts/convert-zh-tw.mjs, which regenerates the zh-tw sources from zh-cn. It is declared so `npm ci` keeps it available.",
  "bin": {
    "cursor-language-pack": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "scripts/lib/",
    "scripts/translate-install.mjs",
    "src/extension/main.cjs",
    "src/i18n/zh-cn/hardcoded.json",
    "src/i18n/zh-tw/hardcoded.json",
    "assets/language-pack.vsix",
    "config.json",
    "LICENSE",
    "NOTICE",
    "src/i18n/zh-cn/commerce.json",
    "src/i18n/zh-tw/commerce.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "cursor",
    "汉化",
    "中文语言包",
    "localization",
    "cli",
    "chinese",
    "zh-cn",
    "zh-tw"
  ]
}
